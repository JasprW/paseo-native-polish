diff --git a/packages/desktop/src/features/native-context-menu.ts b/packages/desktop/src/features/native-context-menu.ts
new file mode 100644
index 000000000..36abc8f98
--- /dev/null
+++ b/packages/desktop/src/features/native-context-menu.ts
@@ -0,0 +1,136 @@
+import {
+  BrowserWindow,
+  ipcMain,
+  Menu,
+  type Event,
+  type MenuItemConstructorOptions,
+} from "electron";
+import type {
+  DesktopNativeMenuItem,
+  DesktopNativeMenuRequest,
+} from "@getpaseo/protocol/desktop-native-menu";
+
+function validateRequest(value: unknown): DesktopNativeMenuRequest {
+  if (!value || typeof value !== "object") throw new Error("Invalid native menu");
+  const input = value as DesktopNativeMenuRequest;
+  if (
+    typeof input.requestId !== "string" ||
+    input.requestId.length > 128 ||
+    !Number.isFinite(input.x) ||
+    !Number.isFinite(input.y) ||
+    !Array.isArray(input.items) ||
+    input.items.length < 1 ||
+    input.items.length > 100
+  ) {
+    throw new Error("Invalid native menu request");
+  }
+  const ids = new Set<string>();
+  for (const item of input.items) {
+    validateItem(item);
+    if (item.type === "separator") continue;
+    if (ids.has(item.id)) throw new Error("Duplicate native menu ID");
+    ids.add(item.id);
+  }
+  return input;
+}
+
+function validateItem(item: DesktopNativeMenuItem): void {
+  if (!item || typeof item !== "object") throw new Error("Invalid native menu item");
+  if (item.type === "separator") return;
+  if (
+    item.type !== "item" ||
+    typeof item.id !== "string" ||
+    item.id.length > 128 ||
+    typeof item.label !== "string" ||
+    !item.label.trim() ||
+    item.label.length > 500 ||
+    typeof item.enabled !== "boolean" ||
+    (item.checked !== undefined && typeof item.checked !== "boolean")
+  ) {
+    throw new Error("Invalid native menu item");
+  }
+}
+
+export function registerNativeContextMenu(): void {
+  const active = new Map<number, { requestId: string; cancel: () => void }>();
+  ipcMain.handle("paseo:menu:showNativeContextMenu", (event, value: unknown) => {
+    const win = BrowserWindow.fromWebContents(event.sender);
+    if (process.platform !== "darwin" || !win || event.senderFrame !== event.sender.mainFrame) {
+      throw new Error("Native context menu unavailable");
+    }
+    const input = validateRequest(value);
+    active.get(event.sender.id)?.cancel();
+    return new Promise<string | null>((resolve, reject) => {
+      let selected: string | null = null;
+      let settled = false;
+      const template: MenuItemConstructorOptions[] = input.items.map((item) =>
+        item.type === "separator"
+          ? { type: "separator" }
+          : {
+              label: item.label,
+              enabled: item.enabled,
+              type: item.checked === undefined ? "normal" : "checkbox",
+              checked: item.checked,
+              click: () => {
+                selected = item.id;
+              },
+            },
+      );
+      const menu = Menu.buildFromTemplate(template);
+      const finish = (error?: unknown) => {
+        if (settled) return;
+        settled = true;
+        active.delete(event.sender.id);
+        event.sender.removeListener("destroyed", cancel);
+        event.sender.removeListener("did-start-navigation", onNavigation);
+        win.removeListener("closed", cancel);
+        if (error !== undefined) reject(error);
+        else resolve(selected);
+      };
+      const closePopup = () => {
+        try {
+          if (!win.isDestroyed()) menu.closePopup(win);
+        } catch {
+          /* Window teardown. */
+        }
+      };
+      const cancel = () => {
+        selected = null;
+        closePopup();
+        finish();
+      };
+      const onNavigation = (
+        _event: Event,
+        _url: string,
+        sameDocument: boolean,
+        mainFrame: boolean,
+      ) => {
+        if (mainFrame && !sameDocument) cancel();
+      };
+      active.set(event.sender.id, { requestId: input.requestId, cancel });
+      event.sender.once("destroyed", cancel);
+      event.sender.on("did-start-navigation", onNavigation);
+      win.once("closed", cancel);
+      const zoom = event.sender.getZoomFactor();
+      const [width, height] = win.getContentSize();
+      try {
+        menu.popup({
+          window: win,
+          x: Math.round(Math.min(Math.max(0, input.x * zoom), width - 1)),
+          y: Math.round(Math.min(Math.max(0, input.y * zoom), height - 1)),
+          callback: () => {
+            setImmediate(finish);
+          },
+        });
+      } catch (error) {
+        closePopup();
+        finish(error);
+      }
+    });
+  });
+  ipcMain.handle("paseo:menu:cancelNativeContextMenu", (event, requestId: unknown) => {
+    if (event.senderFrame !== event.sender.mainFrame) return;
+    const current = active.get(event.sender.id);
+    if (typeof requestId === "string" && current?.requestId === requestId) current.cancel();
+  });
+}
