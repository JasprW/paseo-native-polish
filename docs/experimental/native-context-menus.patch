diff --git a/packages/protocol/src/desktop-native-menu.ts b/packages/protocol/src/desktop-native-menu.ts
new file mode 100644
index 000000000..dc8955123
--- /dev/null
+++ b/packages/protocol/src/desktop-native-menu.ts
@@ -0,0 +1,11 @@
+/** Serializable native menu contract. Renderer callbacks never cross IPC. */
+export type DesktopNativeMenuItem =
+  | { type: "separator" }
+  | { type: "item"; id: string; label: string; enabled: boolean; checked?: boolean };
+
+export interface DesktopNativeMenuRequest {
+  requestId: string;
+  items: DesktopNativeMenuItem[];
+  x: number;
+  y: number;
+}
