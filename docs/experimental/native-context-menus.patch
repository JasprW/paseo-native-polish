diff --git a/packages/app/src/components/ui/menu/native-menu-projection.ts b/packages/app/src/components/ui/menu/native-menu-projection.ts
new file mode 100644
index 000000000..a054a3f33
--- /dev/null
+++ b/packages/app/src/components/ui/menu/native-menu-projection.ts
@@ -0,0 +1,72 @@
+import { createContext, useContext, useId, useLayoutEffect, type ReactNode } from "react";
+import type { DesktopNativeMenuItem } from "@getpaseo/protocol/desktop-native-menu";
+
+export interface NativeMenuEntry {
+  item: DesktopNativeMenuItem;
+  onSelect?: () => void;
+  closeOnSelect?: boolean;
+}
+export interface NativeMenuProjection {
+  entries: Map<string, NativeMenuEntry>;
+  unsupported: Set<string>;
+}
+export const NativeMenuProjectionContext = createContext<NativeMenuProjection | null>(null);
+
+function plainLabel(children: ReactNode): string | null {
+  if (typeof children === "string" || typeof children === "number") return String(children);
+  if (Array.isArray(children)) {
+    const parts = children.map(plainLabel);
+    return parts.every((part) => part !== null) ? parts.join("") : null;
+  }
+  if (children === null || children === undefined || typeof children === "boolean") return "";
+  return null;
+}
+
+/** Register the actual component's action; never inspect DOM or React internals. */
+export function useNativeMenuItem(input: {
+  children?: ReactNode;
+  separator?: boolean;
+  unsupported?: boolean;
+  enabled?: boolean;
+  checked?: boolean;
+  onSelect?: () => void;
+  closeOnSelect?: boolean;
+}): void {
+  const projection = useContext(NativeMenuProjectionContext);
+  const id = useId();
+  const label = plainLabel(input.children);
+  useLayoutEffect(() => {
+    if (!projection) return;
+    if (input.unsupported || (!input.separator && (!label || !label.trim()))) {
+      projection.unsupported.add(id);
+    } else {
+      projection.entries.set(id, {
+        item: input.separator
+          ? { type: "separator" }
+          : {
+              type: "item",
+              id,
+              label: label!,
+              enabled: input.enabled !== false,
+              checked: input.checked,
+            },
+        onSelect: input.onSelect,
+        closeOnSelect: input.closeOnSelect,
+      });
+    }
+    return () => {
+      projection.entries.delete(id);
+      projection.unsupported.delete(id);
+    };
+  }, [
+    projection,
+    id,
+    label,
+    input.separator,
+    input.unsupported,
+    input.enabled,
+    input.checked,
+    input.onSelect,
+    input.closeOnSelect,
+  ]);
+}
diff --git a/packages/app/src/components/ui/native-context-menu.tsx b/packages/app/src/components/ui/native-context-menu.tsx
new file mode 100644
index 000000000..b37b8f8f5
--- /dev/null
+++ b/packages/app/src/components/ui/native-context-menu.tsx
@@ -0,0 +1,96 @@
+import { useEffect, useId, useRef, useState, type ReactElement } from "react";
+import { getDesktopHost } from "@/desktop/host";
+import { MenuSurface, MenuSurfaceProbe, type MenuSurfaceProps } from "./menu/menu-surface";
+import { useMenuContext } from "./menu/menu-context";
+import {
+  NativeMenuProjectionContext,
+  type NativeMenuProjection,
+} from "./menu/native-menu-projection";
+
+export function nativeContextMenusAvailable(): boolean {
+  const host = getDesktopHost();
+  return (
+    host?.platform === "darwin" &&
+    host.menu?.nativeContextMenuVersion === 1 &&
+    typeof host.menu.showNativeContextMenu === "function" &&
+    typeof host.menu.cancelNativeContextMenu === "function" &&
+    typeof document !== "undefined" &&
+    document.body.getAttribute("data-native-polish-native-menus") === "true"
+  );
+}
+
+/** One mounted session per right click. Custom interactive pages keep the web presentation. */
+export function NativeContextMenuSession(props: MenuSurfaceProps): ReactElement | null {
+  const menu = useMenuContext("NativeContextMenuSession");
+  const requestId = useId();
+  const [fallback, setFallback] = useState(false);
+  const projection = useRef<NativeMenuProjection>({ entries: new Map(), unsupported: new Set() });
+  const initialMenu = useRef(menu);
+  const fallbackAction = useRef<(() => void) | null>(null);
+  useEffect(() => {
+    const host = getDesktopHost()?.menu;
+    const current = initialMenu.current;
+    const anchor = current.anchorRect;
+    let alive = true;
+    let requested = false;
+    // Child layout effects populate the projection before this passive effect runs.
+    const entries = [...projection.current.entries.values()];
+    if (
+      !anchor ||
+      !host?.showNativeContextMenu ||
+      projection.current.unsupported.size ||
+      !entries.some(({ item }) => item.type === "item")
+    ) {
+      setFallback(true);
+      return;
+    }
+    requested = true;
+    void host
+      .showNativeContextMenu({
+        requestId,
+        items: entries.map(({ item }) => item),
+        x: anchor.x,
+        y: anchor.y,
+      })
+      .then((selected) => {
+        if (!alive) return undefined;
+        const entry = entries.find(({ item }) => item.type === "item" && item.id === selected);
+        if (!entry || entry.item.type !== "item" || !entry.item.enabled) {
+          current.setOpen(false);
+          return;
+        }
+        // A submenu or a persistent action needs its existing custom page / feedback.
+        if (entry.closeOnSelect === false) {
+          fallbackAction.current = () => current.selectItem(entry.onSelect, false);
+          setFallback(true);
+          return;
+        }
+        current.selectItem(entry.onSelect, true);
+        return undefined;
+      })
+      .catch((error: unknown) => {
+        if (!alive) return undefined;
+        console.warn("[native-menu] using web menu", error);
+        setFallback(true);
+      });
+    return () => {
+      alive = false;
+      if (requested) void host.cancelNativeContextMenu?.(requestId).catch(() => {});
+    };
+  }, [requestId]);
+
+  useEffect(() => {
+    if (!fallback) return;
+    // The real submenu triggers must register their anchors before opening a custom page.
+    const action = fallbackAction.current;
+    fallbackAction.current = null;
+    action?.();
+  }, [fallback]);
+
+  if (fallback) return <MenuSurface {...props} />;
+  return (
+    <NativeMenuProjectionContext.Provider value={projection.current}>
+      <MenuSurfaceProbe>{props.children}</MenuSurfaceProbe>
+    </NativeMenuProjectionContext.Provider>
+  );
+}
